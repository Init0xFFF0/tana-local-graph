# Documentation only: the app does not automatically load .env files.
# Export variables in your terminal. Do not place real tokens in this example.
# TANA_MCP_URL=http://127.0.0.1:8262/mcp
# TANA_MCP_TOKEN=your-local-token
# TANA_MCP_HEADERS={"X-Custom-Header":"your-local-value"}
# QWEN_MODEL_PATH=/path/to/your/downloaded/model
